# Get this from Apify Console > Settings > Integrations
APIFY_TOKEN=your_apify_token_here

# Comma-separated list of Apify Actors to pull from.
# These are known public Actors on Apify Store for remote job boards.
# Swap in whichever ones you've connected via the Apify MCP connector.
APIFY_ACTORS=apify/remote-com-jobs-scraper,apify/remotive-jobs-scraper,apify/remoteok-scraper

PORT=4000

# Used to sign login tokens. Set this to any long random string for real use;
# a dev default is used automatically if you skip this for local testing.
JWT_SECRET=change-this-to-a-long-random-string
